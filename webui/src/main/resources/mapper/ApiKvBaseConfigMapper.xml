<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.cronx.web.mapper.ApiKvBaseConfigMapper">

    <resultMap id="ApiKvBaseConfigDO" type="io.cronx.web.model.entity.ApiKvBaseConfigDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="api_source_id" property="apiSourceId"/>
        <result column="config_name" property="configName"/>
        <result column="config_value" property="configValue"/>
        <result column="default_value" property="defaultValue"/>
        <result column="value_range" property="valueRange"/>
        <result column="desc_key" property="descKey"/>
    </resultMap>

    <sql id="allColumn">
        api_kv_base_config.id id,
        api_kv_base_config.gmt_create gmt_create,
        api_kv_base_config.gmt_modified gmt_modified,
        api_kv_base_config.api_source_id api_source_id,
        api_kv_base_config.config_name config_name,
        api_kv_base_config.config_value config_value,
        api_kv_base_config.default_value default_value,
        api_kv_base_config.value_range value_range,
        api_kv_base_config.desc_key desc_key
    </sql>

    <select id="getConfigByApiIdAndConfigName" resultMap="ApiKvBaseConfigDO">
        SELECT
        <include refid="allColumn"/>
        FROM
        api_kv_base_config
        WHERE
        api_kv_base_config.api_source_id = #{apiSourceId} AND
        api_kv_base_config.config_name = #{configName}
        LIMIT 1
    </select>

    <select id="queryListByApiSourceId" resultMap="ApiKvBaseConfigDO">
        SELECT
        <include refid="allColumn"/>
        FROM
        api_kv_base_config
        WHERE
        api_kv_base_config.api_source_id = #{apiSourceId}
    </select>

    <update id="updateApiSourceConfig">
        UPDATE
            api_kv_base_config
        SET api_kv_base_config.config_value = #{configValue}
        WHERE api_kv_base_config.api_source_id = #{apiSourceId}
          AND api_kv_base_config.config_name = #{configName}
    </update>

    <delete id="deleteApiSourceConfig">
        DELETE
        FROM api_kv_base_config
        WHERE api_kv_base_config.api_source_id = #{apiSourceId}
    </delete>

    <insert id="batchInsertConfig" parameterType="java.util.List">
        INSERT INTO
        api_kv_base_config (api_source_id,config_name,config_value,default_value,value_range,desc_key)
        VALUES
        <foreach collection="configs" item="config" separator=",">
            (#{config.apiSourceId},#{config.configName},#{config.configValue},#{config.defaultValue},#{config.valueRange},#{config.descKey})
        </foreach>
    </insert>

</mapper>
