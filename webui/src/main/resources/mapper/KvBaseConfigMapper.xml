<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.cronx.web.mapper.KvBaseConfigMapper">

    <resultMap id="KvBaseConfigDO" type="io.cronx.web.model.entity.KvBaseConfigDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="task_id" property="taskId"/>
        <result column="config_name" property="configName"/>
        <result column="config_value" property="configValue"/>
        <result column="default_value" property="defaultValue"/>
        <result column="value_range" property="valueRange"/>
        <result column="desc_key" property="descKey"/>
    </resultMap>

    <sql id="allColumn">
        kv_base_config.id id,
        kv_base_config.gmt_create gmt_create,
        kv_base_config.gmt_modified gmt_modified,
        kv_base_config.task_id task_id,
        kv_base_config.config_name config_name,
        kv_base_config.config_value config_value,
        kv_base_config.default_value default_value,
        kv_base_config.value_range value_range,
        kv_base_config.desc_key desc_key
    </sql>

    <insert id="batchInsertConfig" parameterType="java.util.List">
        INSERT INTO
            kv_base_config (task_id,config_name,config_value,default_value,value_range,desc_key)
        VALUES
        <foreach collection="configs" item="config" separator=",">
            (#{config.taskId},#{config.configName},#{config.configValue},#{config.defaultValue},#{config.valueRange},#{config.descKey})
        </foreach>
    </insert>

    <select id="getConfigByTaskIdAndConfigName" resultMap="KvBaseConfigDO">
        SELECT
        <include refid="allColumn"/>
        FROM
            kv_base_config
        WHERE
            kv_base_config.task_id        = #{taskId} AND
            kv_base_config.config_name    = #{configName}
        LIMIT 1
    </select>

    <select id="queryListByTaskId" resultMap="KvBaseConfigDO">
        SELECT
        <include refid="allColumn"/>
        FROM
            kv_base_config
        WHERE
            kv_base_config.task_id        = #{taskId}
    </select>

    <update id="updateTaskConfig">
        UPDATE
            kv_base_config
        SET
            kv_base_config.config_value = #{configValue}
        WHERE
            kv_base_config.task_id = #{taskId} AND
            kv_base_config.config_name = #{configName}
    </update>

    <delete id="deleteTaskConfig">
        DELETE
        FROM
            kv_base_config
        WHERE
            kv_base_config.task_id = #{taskId}
    </delete>

    <delete id="deleteByTaskIds">
        DELETE
        FROM
            kv_base_config
        WHERE
            kv_base_config.task_id in
        <if test="ids != null and ids.size() > 0">
            <foreach collection="ids" open="(" item="id" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </delete>

</mapper>
